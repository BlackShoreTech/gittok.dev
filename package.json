{
	"name": "gittok.dev",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"update-topics": "bun run scripts/get_all_curated_topics.js",
		"update-stars": "bun run scripts/get_all_stars.ts",
		"feature-repos": "bun run scripts/feature_repos.ts",
		"db:setup": "cat drizzle/0000_initial.sql | sqlite3 static/data/db.sqlite"
	},
	"devDependencies": {
		"@eslint/compat": "^2",
		"@eslint/js": "^10",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7",
		"@testing-library/svelte": "^5.4.2",
		"@types/dompurify": "^3.2.0",
		"bun-types": "^1.4.2",
		"drizzle-kit": "^0.30.6",
		"eslint": "^10",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3",
		"globals": "^17",
		"jsdom": "^30",
		"posthog-js": "^1.433.5",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4",
		"prettier-plugin-tailwindcss": "^0.8",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8",
		"vitest": "^5"
	},
	"dependencies": {
		"@libsql/client": "^0.14.0",
		"@octokit/rest": "^22",
		"@sveltejs/adapter-static": "^3.0.10",
		"drizzle-orm": "^0.38.4",
		"isomorphic-dompurify": "^4",
		"lucide-svelte": "^1",
		"marked": "^18",
		"marked-base-url": "^1.1.10",
		"marked-emoji": "^3",
		"sql.js-httpvfs": "^0.8.12",
		"vite-plugin-mkcert": "^2"
	},
	"license": "Proprietary"
}
